<% content_for :title, "Reset password" %>

<div class="mx-auto max-w-md">
  <%= page_header "Update your password", "Choose a new password for your account." %>

  <div class="card">
    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
      <div class="space-y-1">
        <%= form.label :password, "New password", class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72, class: "form-input" %>
      </div>

      <div class="space-y-1">
        <%= form.label :password_confirmation, "Confirm password", class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72, class: "form-input" %>
      </div>

      <%= form.submit "Save password", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
