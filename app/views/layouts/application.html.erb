<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Recipe Scenario Drill" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Recipe Scenario Drill">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full flex-col">
    <header class="sticky top-0 z-50 border-b border-stone-200/80 bg-white/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <%= link_to root_path, class: "group flex items-center gap-2.5" do %>
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-lg shadow-sm transition group-hover:bg-brand-700" aria-hidden="true">🍳</span>
          <span class="font-serif text-lg font-bold text-stone-900">Recipe Drill</span>
        <% end %>

        <nav class="flex flex-wrap items-center justify-end gap-1 sm:gap-2">
          <%= link_to "Recipes", recipes_path, class: current_page?(recipes_path) || controller_name == "recipes" ? "nav-link-active" : "nav-link" %>
          <% if authenticated? %>
            <span class="hidden text-sm text-stone-500 sm:inline"><%= Current.user.email_address %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn-secondary !py-2 !text-xs sm:!text-sm" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "btn-primary !py-2 !text-xs sm:!text-sm" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if alert = flash[:alert] %>
      <div class="mx-auto max-w-5xl px-4 pt-4 sm:px-6">
        <p class="flash-alert" role="alert"><%= alert %></p>
      </div>
    <% end %>
    <% if notice = flash[:notice] %>
      <div class="mx-auto max-w-5xl px-4 pt-4 sm:px-6">
        <p class="flash-notice" role="status"><%= notice %></p>
      </div>
    <% end %>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 sm:py-10">
      <%= yield %>
    </main>

    <footer class="mt-auto border-t border-stone-200/80 bg-white/60 py-6 text-center text-sm text-stone-500">
      <p>Minitest Rails Chapter 4 practice app</p>
    </footer>
  </body>
</html>
