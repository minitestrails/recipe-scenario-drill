<% content_for :title, @recipe.title %>

<h1><%= @recipe.title %></h1>

<% if @recipe.description.present? %>
  <p><%= simple_format @recipe.description %></p>
<% end %>

<dl>
  <% if @recipe.servings.present? %>
    <dt>Servings</dt>
    <dd><%= @recipe.servings %></dd>
  <% end %>
  <% if @recipe.prep_time.present? %>
    <dt>Prep time</dt>
    <dd><%= @recipe.prep_time %> minutes</dd>
  <% end %>
</dl>

<section id="ingredients">
  <h2>Ingredients</h2>
  <% if @recipe.ingredients.any? %>
    <ul>
      <% @recipe.ingredients.each do |ingredient| %>
        <li><%= ingredient.quantity %> <%= ingredient.unit %> <%= ingredient.name %></li>
      <% end %>
    </ul>
  <% else %>
    <p>No ingredients listed.</p>
  <% end %>
</section>

<section id="steps">
  <h2>Steps</h2>
  <% if @recipe.steps.ordered.any? %>
    <ol>
      <% @recipe.steps.ordered.each do |step| %>
        <li><%= step.instruction %></li>
      <% end %>
    </ol>
  <% else %>
    <p>No steps listed.</p>
  <% end %>
</section>

<section id="share">
  <h2>Share recipe</h2>
  <%= form_with url: deliver_share_recipe_path(@recipe), method: :post do |form| %>
    <div>
      <%= form.label :recipient_email, "Friend's email" %>
      <%= form.email_field :recipient_email, required: true, placeholder: "friend@example.com" %>
    </div>
    <%= form.submit "Email recipe" %>
  <% end %>
</section>

<div>
  <% if @recipe.user_id.nil? || @recipe.user_id == Current.user&.id %>
    <%= link_to "Edit this recipe", edit_recipe_path(@recipe) %> |
    <%= button_to "Destroy this recipe", @recipe, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } } %> |
  <% end %>
  <%= link_to "Back to recipes", recipes_path %>
</div>
